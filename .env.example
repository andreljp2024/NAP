# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SGP API Credentials (Sistema de Gestão de Provedores)
# Docs: https://bookstack.sgp.net.br/books/api/page/autenticacoes-via-api
SGP_URL="https://api.sgp.net.br"
SGP_APP="seu_app_id_aqui"
SGP_TOKEN="seu_token_api_aqui"

# PostgreSQL Connection for NAP Backend
DATABASE_URL="postgresql://postgres:nap_secure_pwd@db:5432/nap_crm"

# GenieACS NBI Credentials (API Northbound)
GENIEACS_URL="http://10.0.0.1:7557"
GENIEACS_USER="api_user"
GENIEACS_PASSWORD="api_password"
